# Claude Agent — notification config for usage-limit alerts
# Copy to .env and fill in your values.
# Channels are tried in order: SMS → Email → Discord.
# Leave a section blank to skip that channel.

# ── SMS via Twilio (recommended — most reliable) ──────────────────────────
# Sign up at https://www.twilio.com — free trial available
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1234567890   # Twilio number you own
TWILIO_TO_NUMBER=+0987654321     # your mobile number

# ── Email via SMTP ────────────────────────────────────────────────────────
# Gmail example: use an App Password (not your regular password)
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx    # 16-char App Password
NOTIFY_EMAIL_TO=you@gmail.com
NOTIFY_EMAIL_FROM=claude-agent@gmail.com   # optional, defaults to SMTP_USER

# ── Discord webhook ───────────────────────────────────────────────────────
# In Discord: Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890/xxxxxxxxxxxx
